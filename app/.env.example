# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# URL public al landing-ului WordPress (pt. linkuri în emailuri etc.)
PUBLIC_SITE_URL=https://www.bioecolab.ro

# ─── MongoDB ───────────────────────────────────────────────────────────────
# Portul host (intern containerul rămâne 27017). 27018 ca să nu intre în conflict
# cu alte instanțe MongoDB rulate local.
MONGO_PORT=27018
MONGO_EXPRESS_PORT=8082
MONGO_USER=sncu
MONGO_PASS=sncu
MONGO_DB=sncu
MONGO_URI=mongodb://sncu:sncu@localhost:27018/sncu?authSource=admin

# ─── Auth / JWT ────────────────────────────────────────────────────────────
JWT_SECRET=schimba-acest-secret-in-productie
JWT_EXPIRES=30d
# valabilitate link activare cont / reset parolă (ore)
ACTIVATION_TTL_HOURS=24

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID pentru abonamentul anual (recurring yearly, RON, TVA inclus).
# Opțional: dacă lipsește, aplicația creează/reutilizează automat un Price.
STRIPE_PRICE_ID=

# ─── Oblio (facturare) ─────────────────────────────────────────────────────
# Email = același cu care te loghezi în Oblio (client_id OAuth).
# Token = Oblio → Setări → Date cont (client_secret). Se regenerează la reset parolă.
# Fără ghilimele în valoare.
OBLIO_EMAIL=
OBLIO_API_TOKEN=
# CIF emitent din Oblio → Setări → Date firmă (ex: RO26901702)
OBLIO_CIF=
# Numele seriei din nomenclator (exact), ex: FCT sau sncu
OBLIO_INVOICE_SERIES=
# Numele cotei TVA din nomenclator (trebuie să corespundă cu VAT_RATE / percent)
OBLIO_VAT_NAME=Normala

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BioEcoLab <noreply@bioecolab.ro>"
ADMIN_EMAIL=office@bioecolab.ro
# Logo afișat în antetul emailurilor (URL public absolut)
MAIL_LOGO_URL=https://www.bioecolab.ro/wp-content/uploads/2026/01/bioecolab-logo.png

# ─── Pricing (lei, fără TVA) — preț fix / an, indiferent de puncte de lucru ─
PRICE_BASE=330
VAT_RATE=0.21
